<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Welcome, <%= name %>!</h2>
    <p>Email: <%= email %></p>

    
    <h3>Projects you've signed up for!</h3>
    
    <% if (projects.length <= 0) { %>
        <p>Looks like you haven't signed up for anything...</p>
        
        <% } %>
        
        <% projects.forEach(project => { %>    
            <a href="/project/<%= project.project_id %>"><%= project.title %> --</a>
            <form class="dash-form" action="/project/<%= project.project_id %>/leave" method="POST">
                <button type="submit">Leave Project</button>
            </form>
            <br><br>
            <% }); %>
            
        <% if (user && user.role === 'admin') { %>
            <h3>Admin Control</h3>
            <a href="/new-organization">new organization</a><br>
            <a href="/new-category">new category</a><br>
            <a href="/new-project">new service project</a><br>
            <a href="/users">all users</a>
        <% } %>
            
        </main>
        
<%- include('partials/footer') %>