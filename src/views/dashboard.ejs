<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role === 'admin') { %>
        <p><a href="/new-organization">new organization</a></p>
        <p><a href="/new-category">new category</a></p>
        <p><a href="/new-project">new service project</a></p>
        <p><a href="/users">all users</a></p>
    <% } %>

    <h3>Projects you've signed up for!</h3>

    <% if (projects.length <= 0) { %>
        <p>Looks like you haven't signed up for anything...</p>

    <% } %>

    <% projects.forEach(project => { %>    
        <a href="/project/<%= project.project_id %>"><%= project.title %> --</a>
        <form class="dash-form" action="/project/<%= project.project_id %>/leave" method="POST">
            <button type="submit">Leave Project</button>
        </form>
        <br><br>
    <% }); %>


</main>

<%- include('partials/footer') %>